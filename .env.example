# Copy this file to .env and replace every placeholder locally.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=replace-with-a-least-privilege-supabase-key
OPENAI_API_KEY=replace-with-openai-api-key
SERPER_API_KEY=replace-with-serper-api-key
DB_USER=postgres
DB_HOST=your-database-host
DB_PORT=5432
DB_NAME=postgres
DB_PASSWORD=replace-with-database-password
